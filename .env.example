PORT=3100

# Base local por defecto:
# DocFlow guarda usuarios, sesiones, documentos y operaciones en data/docflow.sqlite usando sql.js.

# TiDB Cloud / MySQL en produccion:
# Opcion A: una URL completa
# DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE
#
# Opcion B: parametros separados
# TIDB_HOST=tu-host.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=tu_usuario
# TIDB_PASSWORD=tu_password
# TIDB_DATABASE=docflow
# DOCFLOW_STORE_FILES_IN_DB=true
#
# TLS recomendado para TiDB Cloud:
# TIDB_CA_PATH=C:\ruta\isrgrootx1.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# En Vercel configura estas variables en Project Settings -> Environment Variables:
# TIDB_HOST, TIDB_PORT, TIDB_USER, TIDB_PASSWORD, TIDB_DATABASE,
# DOCFLOW_STORE_FILES_IN_DB=true, GOOGLE_CLIENT_ID y REACT_APP_GOOGLE_CLIENT_ID.

# Para Google:
GOOGLE_CLIENT_ID=660499321480-v9blu82drm6fctvchpt1u4u0o5a8lqvk.apps.googleusercontent.com
REACT_APP_GOOGLE_CLIENT_ID=660499321480-v9blu82drm6fctvchpt1u4u0o5a8lqvk.apps.googleusercontent.com
# En Google Cloud Console agrega este origen autorizado de JavaScript:
# http://localhost:3100
